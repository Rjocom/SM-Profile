---
import { waLink, type Casket } from '../data/caskets';

interface Props {
  casket: Casket;
  loading: 'eager' | 'lazy';
  priority: boolean;
}
const { casket, loading, priority } = Astro.props;
const href = waLink(
  `Halo Serenity Memorial, saya ingin menanyakan peti ${casket.name}.`
);
---

<article class="casket fade-in">
  <div class="plate">
    <img
      src={casket.image}
      alt={`Peti ${casket.name}`}
      loading={loading}
      decoding="async"
      fetchpriority={priority ? 'high' : 'auto'}
    />
  </div>
  <div class="info">
    <h3>{casket.name}</h3>
    <p>{casket.description}</p>
    <p class="price">
      <small>Harga</small>{casket.price}
    </p>
    <a class="ask" href={href} target="_blank" rel="noopener">Tanya model ini</a>
  </div>
</article>