---
import { waLink } from "../data/caskets";
const waHref = waLink("Halo Serenity Memorial, saya membutuhkan bantuan.");
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<header class="top">
  <div class="wrap">
    <a href="/" aria-label="Serenity Memorial">
      <img src="/images/logo.webp" alt="Serenity Memorial" width="92" />
    </a>

    <nav class="nav-desktop" aria-label="Navigasi utama">
      <a href="/tentang" aria-current={currentPath === "/tentang" ? "page" : undefined}>Tentang</a>
      <a href="/visi-misi" aria-current={currentPath === "/visi-misi" ? "page" : undefined}>Visi &amp; Misi</a>
      <a href="/layanan" aria-current={currentPath === "/layanan" ? "page" : undefined}>Layanan</a>
      <a href="/koleksi-peti" aria-current={currentPath === "/koleksi-peti" ? "page" : undefined}>Koleksi Peti</a>
      <a href="/dekorasi" aria-current={currentPath === "/dekorasi" ? "page" : undefined}>Dekorasi</a>
      <a href="/kontak" aria-current={currentPath === "/kontak" ? "page" : undefined}>Kontak</a>
    </nav>

    <a
      class="btn btn-gold btn-sm btn-wa"
      href={waHref}
      target="_blank"
      rel="noopener"
    >
      WhatsApp 24 Jam
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-label="Buka menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Perbaikan: Ini harusnya nav-mobile, bukan nav-desktop -->
  <nav class="nav-mobile" id="mobile-nav" aria-label="Navigasi mobile" hidden>
    <a href="/tentang" aria-current={currentPath === "/tentang" ? "page" : undefined}>Tentang</a>
    <a href="/visi-misi" aria-current={currentPath === "/visi-misi" ? "page" : undefined}>Visi &amp; Misi</a>
    <a href="/layanan" aria-current={currentPath === "/layanan" ? "page" : undefined}>Layanan</a>
    <a href="/koleksi-peti" aria-current={currentPath === "/koleksi-peti" ? "page" : undefined}>Koleksi Peti</a>
    <a href="/dekorasi" aria-current={currentPath === "/dekorasi" ? "page" : undefined}>Dekorasi</a>
    <a href="/kontak" aria-current={currentPath === "/kontak" ? "page" : undefined}>Kontak</a>
    <a class="btn btn-gold" href={waHref} target="_blank" rel="noopener">
      WhatsApp 24 Jam
    </a>
  </nav>
</header>

<script>
  function setupMobileNav() {
    const toggle = document.querySelector(".nav-toggle") as HTMLElement | null;
    const mobileNav = document.querySelector(".nav-mobile") as HTMLElement | null;

    if (toggle && mobileNav) {
      // Hapus event listener lama (jika ada) dengan cara kloning elemen
      // Ini mencegah menu terbuka/tertutup dua kali (double click) saat pindah halaman
      const newToggle = toggle.cloneNode(true) as HTMLElement;
      toggle.parentNode?.replaceChild(newToggle, toggle);

      newToggle.addEventListener("click", () => {
        const isOpen = newToggle.getAttribute("aria-expanded") === "true";
        newToggle.setAttribute("aria-expanded", String(!isOpen));
        newToggle.setAttribute("aria-label", isOpen ? "Buka menu" : "Tutup menu");
        newToggle.classList.toggle("is-open", !isOpen);
        mobileNav.hidden = isOpen;
        document.body.classList.toggle("nav-open", !isOpen);
      });

      // Tutup menu saat link diklik
      mobileNav.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          newToggle.setAttribute("aria-expanded", "false");
          newToggle.setAttribute("aria-label", "Buka menu");
          newToggle.classList.remove("is-open");
          mobileNav.hidden = true;
          document.body.classList.remove("nav-open");
        });
      });

      // Tutup menu otomatis jika layar diperbesar ke ukuran desktop
      window.addEventListener("resize", () => {
        if (window.innerWidth > 820) {
          newToggle.setAttribute("aria-expanded", "false");
          newToggle.classList.remove("is-open");
          mobileNav.hidden = true;
          document.body.classList.remove("nav-open");
        }
      });
    }
  }

  // Jalankan saat halaman pertama kali dimuat
  setupMobileNav();

  // Jalankan ulang setiap kali halaman berpindah (View Transitions)
  document.addEventListener("astro:after-swap", setupMobileNav);
</script>