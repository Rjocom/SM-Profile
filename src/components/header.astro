---
import { waLink } from '../data/caskets';
const waHref = waLink('Halo Serenity Memorial, saya membutuhkan bantuan.');
---

<header class="top">
  <div class="wrap">
    <a href="#atas" aria-label="Serenity Memorial">
      <img src="/images/logo.png" alt="Serenity Memorial" width="92" />
    </a>

    <nav class="nav-desktop" aria-label="Navigasi utama">
      <a href="#tentang">Tentang</a>
      <a href="#visi">Visi &amp; Misi</a>
      <a href="#layanan">Layanan</a>
      <a href="#peti">Koleksi Peti</a>
      <a href="#dekorasi">Dekorasi</a>
      <a href="#kontak">Kontak</a>
    </nav>

    <a class="btn btn-gold btn-sm btn-wa" href={waHref} target="_blank" rel="noopener">
      WhatsApp 24 Jam
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-label="Buka menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <nav class="nav-mobile" id="mobile-nav" aria-label="Navigasi mobile" hidden>
    <a href="#tentang">Tentang</a>
    <a href="#visi">Visi &amp; Misi</a>
    <a href="#layanan">Layanan</a>
    <a href="#peti">Koleksi Peti</a>
    <a href="#dekorasi">Dekorasi</a>
    <a href="#kontak">Kontak</a>
    <a class="btn btn-gold" href={waHref} target="_blank" rel="noopener">
      WhatsApp 24 Jam
    </a>
  </nav>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const mobileNav = document.querySelector('.nav-mobile');

  if (toggle && mobileNav) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Buka menu' : 'Tutup menu');
      toggle.classList.toggle('is-open', !isOpen);
      mobileNav.hidden = isOpen;
      document.body.classList.toggle('nav-open', !isOpen);
    });

    // Tutup menu saat link diklik
    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Buka menu');
        toggle.classList.remove('is-open');
        mobileNav.hidden = true;
        document.body.classList.remove('nav-open');
      });
    });
  }
</script>