---
import { waLink } from '../data/caskets';
const waHref = waLink('Halo Serenity Memorial, saya membutuhkan bantuan.');
---

<section class="hero" id="atas" style="padding-block: clamp(48px, 7vw, 96px);">
  <svg
    class="hero-waves"
    viewBox="0 0 1440 700"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      d="M-20 560 C 260 420, 460 640, 760 500 S 1220 360, 1480 470"
      fill="none"
      stroke="#c9a24d"
      stroke-width="1.2"
      opacity=".7"
    ></path>
    <path
      d="M-20 590 C 280 460, 470 660, 770 530 S 1230 400, 1480 505"
      fill="none"
      stroke="#c9a24d"
      stroke-width=".8"
      opacity=".5"
    ></path>
    <path
      d="M-20 620 C 300 500, 480 680, 780 560 S 1240 440, 1480 540"
      fill="none"
      stroke="#c9a24d"
      stroke-width=".6"
      opacity=".35"
    ></path>
  </svg>

  <div class="wrap">
    <div class="hero-copy">
      <p class="eyebrow">Funeral Director &amp; Memorial Service · Manado</p>
      <h1>Where Memories are <span>Honored</span></h1>
      <p class="lead">
        Kehilangan orang tercinta adalah momen yang berat. Serenity Memorial
        mendampingi setiap keluarga dengan pelayanan yang penuh empati,
        profesional, dan bermartabat.
      </p>
      <div class="cta-row">
        <a class="btn btn-gold" href={waHref} target="_blank" rel="noopener">
          Hubungi via WhatsApp
        </a>
        <a class="btn btn-line" href="#peti">Lihat Koleksi Peti</a>
      </div>
      <ul class="facts">
        <li>Layanan 24 jam</li>
        <li>Pengiriman ke seluruh Indonesia</li>
        <li>Pendampingan keluarga duka</li>
      </ul>
    </div>

    <div class="arch">
      <div class="arch-frame">
        <img
          src="/images/hero.jpg"
          alt="Armada Serenity Memorial di depan gedung layanan saat senja"
          width="700"
          height="983"
        />
      </div>
      <div class="badge">
        <b>24 Jam</b>Siap melayani kapan saja dan di mana saja
      </div>
    </div>
  </div>
</section>